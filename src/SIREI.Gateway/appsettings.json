{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      // Todo lo que llega (páginas, fragmentos htmx, CSS, JS, fuentes) va a SIREI.Web.
      "sirei-web": {
        "ClusterId": "sirei-web",
        "Match": { "Path": "{**resto}" }
      }
    },
    "Clusters": {
      "sirei-web": {
        // Cada 10 s se pide /health a cada destino; tras dos fallos seguidos, el gateway deja de enviarle tráfico.
        // HealthyAndUnknown: si no queda ningún destino sano responde 503 directamente
        // (con el valor por defecto, HealthyOrPanic, seguiría intentándolo con todos y respondería 502).
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "sirei-web-1": { "Address": "http://localhost:5049/" }
        }
      }
    }
  }
}
